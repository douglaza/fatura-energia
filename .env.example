# ---------------------------------------------------------------------------
# Copie para .env e preencha. O .env NÃO é versionado.
# ---------------------------------------------------------------------------

# Banco de dados (API / parser)
DATABASE_URL=postgresql+psycopg2://cemig:cemig123@localhost:5432/cemig_bill

# ---------------------------------------------------------------------------
# Automação de download no portal CEMIG (prefixo CEMIG_)
# ---------------------------------------------------------------------------

# Credenciais do portal. São opcionais: sem elas o login é 100% manual.
# CEMIG_USER é o mesmo valor digitado no site (e-mail ou CPF).
CEMIG_USER=
CEMIG_PASSWORD=
# CEMIG_INSTALACAO=0000000000

# Onde o PDF baixado é salvo
CEMIG_DOWNLOAD_DIR=data/raw

# Com login manual a cada execução o browser precisa de tela (reCAPTCHA).
# Mantenha false.
CEMIG_HEADLESS=false


POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=


# ---------------------------------------------------------------------------
# [PERSISTÊNCIA] Desativado na v1 — reative junto com o código em
# app/downloader/auth.py (procure por "[PERSISTÊNCIA]").
#
# interactive = abre o Chromium para o humano resolver o reCAPTCHA e salva a sessão
# reuse       = só reaproveita a sessão salva (para cron/servidor, sem tela)
# CEMIG_AUTH_MODE=interactive
#
# Arquivo onde a sessão autenticada é persistida
# CEMIG_STATE_FILE=data/state/storage_state.json
#
# Margem de segurança (minutos) antes de considerar o token expirado
# CEMIG_TOKEN_REFRESH_MARGIN_MINUTES=15
# ---------------------------------------------------------------------------
